meta {
  name: Studafy QA School B · FINANCE
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/auth/login/qa
  body: json
  auth: none
}

body:json {
  {
    "email": "finance@qa-b.studafy.test",
    "password": "{{qaPassword}}",
    "channel": "web"
  }
}

script:post-response {
  if (res.status === 200) bru.setEnvVar("QA_TOKEN_B_FINANCE", res.body.access_token);
}

tests {
  test("signed in", () => expect(res.status).to.equal(200));
}
