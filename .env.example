# =================================================================================================
# Studafy — local development environment
# Copy to .env (`cp .env.example .env`), run `bun run db:up`, then fill in any keys you need.
# Only local, non-secret defaults are filled in here. Real keys never go in this file: the repo is public.
# =================================================================================================


# ---------------------------------------------------------------------------- Runtime
# NODE_ENV=                              # development | test | production (default: development). Leave unset: Vite rejects NODE_ENV=development in .env for production builds
APP_ENV=development                      # development | staging | production
LOG_LEVEL=info                           # trace | debug | info | warn | error | fatal
# RELEASE_VERSION=
# SHUTDOWN_TIMEOUT_MS=                   # (default: 10000)
# READINESS_TIMEOUT_MS=                  # (default: 5000)
# OTEL_EXPORTER_OTLP_ENDPOINT=           # OpenTelemetry collector; tracing is off when unset


# ---------------------------------------------------------------------------- API server (apps/api)
PORT=3000
HOST=127.0.0.1                           # (default: 0.0.0.0)
# SERVICE_NAME=                          # (default: api — workers: workers, realtime: realtime)
# METRICS_PORT=                          # Prometheus metrics port (default: 9464)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated
RATE_LIMIT_DISABLED=true                 # local only — page reloads otherwise hit the auth refresh limit


# ---------------------------------------------------------------------------- Database (Postgres)
# Local Postgres from db/compose.yml (`bun run db:up`) listens on 54329.
# Use the discrete DATABASE_* keys below. Do NOT also set DATABASE_URL: migrations refuse the two
# together, and the API and workers both prefer the discrete keys when present.
# POSTGRES_PASSWORD=studafy_test        # container password for db/compose.yml (default: studafy_test). Docker reads it from
#                                        # the shell or db/.env, not this file, so keep DATABASE_PASSWORD in step with it.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54329
DATABASE_NAME=postgres
DATABASE_USER=studafy_test
DATABASE_PASSWORD=studafy_test
DATABASE_SSL_MODE=disable                # disable | require | verify-full
# DATABASE_CA_CERT=
# DATABASE_URL=

# Read replica (optional — falls back to the primary when unset)
# READ_DATABASE_HOST=
# READ_DATABASE_PORT=
# READ_DATABASE_NAME=
# READ_DATABASE_URL=

# Database tests and tooling
# TEST_DATABASE_URL=
# MIGRATIONS_DIR=                        # (default: db/migrations)
# SEEDS_DIR=                             # (default: db/seeds)
# SEED_ALLOW_NONLOCAL=
# REVIEW_TENANT_SEED_CONFIRM=


# ---------------------------------------------------------------------------- Redis
# Local Redis from db/compose.yml listens on 6390.
REDIS_URL=redis://127.0.0.1:6390


# ---------------------------------------------------------------------------- Auth / JWT
# JWT_ISSUER=                            # (default: studafy)
# JWT_AUDIENCE=                          # (default: studafy-api)
# JWT_ACCESS_TTL_SECONDS=                # (default: 900)
# JWT_REFRESH_TTL_SECONDS=
# JWT_KEY_ROTATION_INTERVAL_MS=

# Demo sign-in ("Continue with Mock" on the login page). Development only — ignored in production.
MOCK_OAUTH_ISSUER_URL=http://localhost:3000/mock-idp
MOCK_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/mock/callback

# Google sign-in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# Microsoft sign-in
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/microsoft/callback

# App-store review account password (see db/seeds/review-credentials.ts)
# REVIEW_LOGIN_PASSWORD=

# Cloudflare Turnstile (bot check on public forms). Server-side secret; the site key is VITE_ below.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # Cloudflare test key (always passes) — local only


# ---------------------------------------------------------------------------- Realtime (apps/realtime)
# WS_JWT_SECRET=


# ---------------------------------------------------------------------------- Finance: ERPNext
# Accounting backend. Without it the Finance dashboard's collections / aging / overdue cards error.
ERPNEXT_API_URL=http://127.0.0.1:8080          # local ERPNext from db/compose.yml (bun run erpnext:up)
ERPNEXT_API_KEY=studafylocalkey01:studafy-local-erpnext-secret   # local-only integration key (bun run erpnext:site sets it)
ERPNEXT_SITE_DOMAIN=erpnext.localhost          # sites are <school-slug>.erpnext.localhost locally
ERPNEXT_WEBHOOK_SECRET=studafy-local-erpnext-webhook   # local-only; bun run erpnext:site signs each site's webhooks with it
RECONCILIATION_API_KEY=studafy-local-reconciliation   # local-only service key for POST /api/finance/reconciliation/run


# ---------------------------------------------------------------------------- Payments
# Stripe (school subscriptions)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Tap (tuition payments). Secret keys start with sk_.
# TAP_SECRET_KEY=
# TAP_TEST_SECRET_KEY=
# TAP_WEBHOOK_URL=
# TAP_COUNTRIES=                   # e.g. JO; empty = every school bills through Stripe
# PAYMENT_REDIRECT_BASE_URL=

# In-app purchase of the AI add-on in the mobile app (docs/runbooks/in-app-purchase-setup.md).
# Each store is off while its values are empty.
# AI_STORE_PRODUCT_ID=studafy_ai_monthly
# APPLE_IAP_BUNDLE_ID=com.studafy.studafyMobile.dev
# APPLE_IAP_APP_APPLE_ID=
# GOOGLE_PLAY_PACKAGE_NAME=com.studafy.studafy_mobile.dev
# GOOGLE_PLAY_SERVICE_ACCOUNT=      # the service account's JSON key, on one line
# GOOGLE_PLAY_RTDN_TOKEN=           # random secret, at least 16 characters


# ---------------------------------------------------------------------------- AI (Together AI / Anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=                    # gateway/proxy override; defaults to the Anthropic API
# Together AI (Qwen). Turn AI on by setting both lines below the block:
#   AI_LLM_API_KEY=<key from api.together.ai → Settings → API Keys>
#   AI_LLM_ENABLED=true
AI_LLM_PROVIDER=openai-compatible         # anthropic | openai-compatible
AI_LLM_BASE_URL=https://api.together.xyz/v1
AI_LLM_SMALL_MODEL=Qwen/Qwen3.5-9B
AI_LLM_LARGE_MODEL=Qwen/Qwen3.5-9B
# AI_LLM_API_KEY=
# AI_LLM_ENABLED=
# AI_LLM_MAX_TOKENS=
# AI_LLM_TIMEOUT_MS=
# AI_LLM_ZERO_RETENTION=
# AI_RERANK_ENABLED=
# AI_MONTHLY_SPEND_BUDGET_USD=


# ---------------------------------------------------------------------------- File storage (S3)
S3_APP_FILES_BUCKET=studafy-files
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000         # local S3 from db/compose.yml (bun run db:up; console http://127.0.0.1:9001)
S3_ACCESS_KEY_ID=studafy-local
S3_SECRET_ACCESS_KEY=studafy-local-secret
# Workers use the AWS SDK default credential chain, not S3_*; local S3 from db/compose.yml only.
AWS_ACCESS_KEY_ID=studafy-local
AWS_SECRET_ACCESS_KEY=studafy-local-secret
# S3_PRESIGN_TTL_SECONDS=                # 900–3600 (default: 900)


# ---------------------------------------------------------------------------- Email (AWS SES)
# SES_REGION=
# SES_FROM_ADDRESS=                      # (default: invitations@mail.studafy.com)
# EMAIL_EVENTS_SNS_TOPIC_ARN=
# EMAIL_BATCH_SIZE=                      # (default: 25)
# EMAIL_MAX_RATE_PER_SECOND=             # (default: 5)
# EMAIL_POLL_INTERVAL_MS=                # (default: 1000)


# ---------------------------------------------------------------------------- Push notifications
# FIREBASE_SERVICE_ACCOUNT=


# ---------------------------------------------------------------------------- Workers (apps/workers)
# SCHOOL_IDS=
# ENTITLEMENT_BATCH_SIZE=                # (default: 100)
# ENTITLEMENT_POLL_INTERVAL_MS=          # (default: 500)
# INGESTION_MAX_CONCURRENCY_PER_SCHOOL=  # (default: 2)
API_BASE_URL=http://127.0.0.1:3000             # the API, for the daily finance reconciliation the workers trigger

# Virus scanning (ClamAV)
CLAMAV_HOST=127.0.0.1                    # local ClamAV from db/compose.yml (bun run db:up)
# CLAMAV_PORT=                           # (default: 3310)
# CLAMAV_TIMEOUT_MS=                     # (default: 30000)
# CLAMAV_MAX_FILE_BYTES=

# OCR
# OCR_LANG_PATH=
# OCR_WORKER_PATH=
# OCR_LOW_CONFIDENCE_THRESHOLD=          # 0–100 (default: 60)


# ---------------------------------------------------------------------------- Mobile app version gate
# MOBILE_LATEST_VERSION_IOS=
# MOBILE_LATEST_VERSION_ANDROID=
# MOBILE_MIN_SUPPORTED_VERSION_IOS=
# MOBILE_MIN_SUPPORTED_VERSION_ANDROID=


# ---------------------------------------------------------------------------- Web app (apps/web, Vite)
# VITE_* values are compiled into the browser bundle — never put a secret in one.
VITE_API_BASE_URL=http://localhost:3000
# VITE_REALTIME_BASE_URL=
# VITE_ENABLE_MOCK_AUTH=                 # "true" shows demo sign-in on a production build (always on in dev)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA      # Cloudflare test key (always passes) — local only
# VITE_MARKETING_CONTACT_EMAIL=
# VITE_RELEASE_VERSION=
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=


# ---------------------------------------------------------------------------- Build / CI tooling
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# DOCS_API_OUT=                          # apps/docs-api output dir
# DOCS_API_RELEASE_TAG=
