# ──────────────────────────────────────────────
# Shared
# ──────────────────────────────────────────────
NODE_ENV=development

# ──────────────────────────────────────────────
# API (apps/api) — defaults to port 3000
# ──────────────────────────────────────────────
# PORT=3000
# HOST=0.0.0.0
# SHUTDOWN_TIMEOUT_MS=10000
# LOG_LEVEL=info
# SERVICE_NAME=api
# RELEASE_VERSION=unknown
# REDIS_URL=rediss://localhost:6379/0

# ──────────────────────────────────────────────
# Database — local Postgres
# ──────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=54329
DATABASE_NAME=studafy
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_SSL_MODE=disable

# ──────────────────────────────────────────────
# Web (apps/web) — Vite dev server
# ──────────────────────────────────────────────
# Origin of the Studafy API consumed by the generated @studafy/api-client.
# Defaults to http://localhost:3000 when unset. Must be VITE_-prefixed to reach the browser bundle.
# VITE_API_BASE_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Realtime Gateway (apps/realtime) — defaults to port 3001
# ──────────────────────────────────────────────
# PORT=3001
REDIS_URL=redis://localhost:6379
WS_JWT_SECRET=changeme

# ──────────────────────────────────────────────
# Workers (apps/workers)
# ──────────────────────────────────────────────
# SHUTDOWN_TIMEOUT_MS=10000
