{
  "name": "@studafy/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist && tsc --project tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist --noEmit false",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "9.1.13",
    "@storybook/addon-themes": "9.1.13",
    "@storybook/react-vite": "9.1.13",
    "@studafy/config": "workspace:*",
    "@studafy/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "9.1.13",
    "typescript": "^5.9.3",
    "vite": "8.1.3"
  }
}
