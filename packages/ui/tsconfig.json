{
  "extends": "@studafy/tsconfig/packages.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // `bun:test` is declared by @types/bun. Naming it here rather than relying on the automatic
    // node_modules/@types sweep is what lets an editor's TypeScript server find it too.
    "types": ["bun"]
  },
  "include": ["src"]
}
