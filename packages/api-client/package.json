{
  "name": "@studafy/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "bun run scripts/build-api-client.ts && prettier --write src/generated-types.ts",
    "check-drift": "bun run scripts/check-drift.ts",
    "verify": "bun run scripts/verify-pipeline.ts",
    "build": "bun build ./src/index.ts --outdir dist --packages=external && tsc --project tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist --noEmit false",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test"
  },
  "dependencies": {
    "@studafy/constants": "workspace:*",
    "@studafy/shared-schemas": "workspace:*",
    "openapi-fetch": "0.17.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@studafy/config": "workspace:*",
    "@studafy/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3"
  }
}
