{
  "name": "@studafy/records",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./src/browser.ts"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --packages=external --target bun && tsc --project tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist --noEmit false",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test"
  },
  "devDependencies": {
    "@studafy/config": "workspace:*",
    "@studafy/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "^5.9.3"
  }
}
