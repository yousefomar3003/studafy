# Deploy-time parameters for the "prod" environment. Sourced by infra/deploy/scripts/render.sh.
# See dev.env's header comment for why this file is split into "not provisioned yet" and
# "this ticket's actual policy" sections — same split applies here.

# --- Not yet provisioned by any Terraform module — fill in once the compute-tier module lands ---
ECS_CLUSTER=
ECS_EXECUTION_ROLE_ARN=
PRIVATE_APP_SUBNET_IDS=
APP_SECURITY_GROUP_ID=
API_TARGET_GROUP_ARN=
REALTIME_TARGET_GROUP_ARN=

# --- Distributed tracing (ST-260) ---
# See staging.env's own comment — same fixed DNS name, module.monitoring.monitoring_enabled is
# true here too.
OTEL_COLLECTOR_ENDPOINT=http://otel-collector.metrics.internal:4318

# --- Deploy tier and public web origin ---
# APP_ENV is the API's tier switch: anything but "development" enforces CORS_ALLOWED_ORIGINS and an
# enforcing CSP (apps/api/src/env.ts, config/security.ts). WEB_ORIGIN is the web app's public origin
# and must match web_origin in infra/terraform/environments/prod/prod.tfvars; render.sh feeds it
# to the API's CORS_ALLOWED_ORIGINS and to api/workers FRONTEND_URL (links in emails).
APP_ENV=production
WEB_ORIGIN=https://app.studafy.com

# --- Error monitoring ---
# The Sentry environment api/workers/realtime group their events under — the same tier names as
# apps/api's APP_ENV. The DSN itself is not here: it comes from each service's app-secrets
# container (SENTRY_DSN, empty = monitoring off). See apps/api/docs/error-monitoring.md.
SENTRY_ENVIRONMENT=production

# --- Rolling-update policy (this ticket's deliverable) ---
# One notch more headroom than staging (cpu/memory + desiredCount) — not a load-tested figure,
# same "starting point, not a researched sizing" caveat as dev.env/staging.env. Revisit once real
# traffic data exists.
API_DESIRED_COUNT=3
API_CPU=1024
API_MEMORY=2048
API_MIN_HEALTHY_PERCENT=100
API_MAX_PERCENT=200

REALTIME_DESIRED_COUNT=3
REALTIME_CPU=1024
REALTIME_MEMORY=2048
REALTIME_MIN_HEALTHY_PERCENT=100
REALTIME_MAX_PERCENT=200

WORKERS_DESIRED_COUNT=3
# Sized for two containers: workers plus the ClamAV sidecar (clamd holds ~1.5 GB of signatures
# resident). Fargate only offers memory in steps a given CPU size allows.
WORKERS_CPU=2048
WORKERS_MEMORY=6144
WORKERS_MIN_HEALTHY_PERCENT=100
WORKERS_MAX_PERCENT=200

# --- Public addresses and deployment tier (rendered into the api and workers task definitions) ---
# APP_ENV is the tier apps/api/src/env.ts gates on (CORS allowlist required, mock sign-in and
# DATABASE_SSL_MODE=disable refused, Turnstile secret required outside development). WEB_ORIGIN
# is the browser origin the API allows and links back to (FRONTEND_URL / CORS_ALLOWED_ORIGINS,
# and the workers' email links); it mirrors this tier's web_origin in its terraform tfvars.
# API_ORIGIN is the public API host; the OAuth redirect URIs are derived from it and must be
# registered, character for character, on each provider's client for this tier.
APP_ENV=production
WEB_ORIGIN=https://app.studafy.com
API_ORIGIN=https://api.studafy.com

# --- AI provider (rendered into the api and workers task definitions) ---
# Together AI's OpenAI-compatible API serving Qwen 3.5 for every AI feature. The credential is
# AI_LLM_API_KEY in BOTH the api and the workers app secrets (docs/runbooks/production-secrets.md).
# AI_LLM_ENABLED=true makes apps/api refuse to boot without that key, so a tier deployed without
# it fails its deploy instead of silently shipping with AI switched off. Model ids must match
# Together's exactly (https://docs.together.ai/docs/serverless/models).
AI_LLM_ENABLED=true
AI_LLM_PROVIDER=openai-compatible
AI_LLM_BASE_URL=https://api.together.xyz/v1
AI_LLM_SMALL_MODEL=Qwen/Qwen3.5-9B
AI_LLM_LARGE_MODEL=Qwen/Qwen3.5-9B

# --- ERPNext (rendered into the api task definition) ---
# Each school's Frappe site is <school-slug>.$ERPNEXT_SITE_DOMAIN, created by
# infra/deploy/scripts/erpnext-new-site.sh. Only a Host header inside the VPC (the internal ALB picks
# the site from it), never a public DNS name. ERPNEXT_API_URL itself comes from terraform output in
# render.sh, and the credential is ERPNEXT_API_KEY in the api and workers app secrets.
ERPNEXT_SITE_DOMAIN=erpnext.studafy.com

# --- Payment provider routing (rendered into the api task definition) ---
# Countries whose schools are billed through Tap, comma separated; every other school (and every
# school while this is empty) is billed through Stripe. Tap only takes merchants registered in its own
# markets and Studafy's company is Irish, so this stays empty unless a Jordan/Gulf entity holds the
# Tap account (docs/runbooks/tap-payments-setup.md).
TAP_COUNTRIES=

# --- In-app purchase of the AI add-on (rendered into the api task definition) ---
# The mobile app sells the AI add-on through the App Store / Google Play (the website keeps
# Tap/Stripe). Each store stays off while its id here is empty; fill it in when that store's setup in
# docs/runbooks/in-app-purchase-setup.md is done. This tier's app ids: App Store com.studafy.studafyMobile,
# Google Play com.studafy.studafy_mobile. APPLE_IAP_APP_APPLE_ID is the numeric "Apple ID" in App Store Connect
# (required with the bundle id in production). Google Play also needs GOOGLE_PLAY_SERVICE_ACCOUNT
# and GOOGLE_PLAY_RTDN_TOKEN in the api app secret, or the api refuses to boot.
AI_STORE_PRODUCT_ID=studafy_ai_monthly
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_APP_APPLE_ID=
GOOGLE_PLAY_PACKAGE_NAME=

# --- Transactional email (rendered into the workers task definition) ---
# Sent through SES from the domain module.dns verifies (prod.tfvars dns_ses_domain = send.studafy.com),
# in this account's region. The workers refuse to boot in production without SES_REGION unless
# EMAIL_DRY_RUN=true, so email can never stop silently. Before real users: request SES production
# access (an account starts in the SES sandbox, which only delivers to verified addresses) -- see
# docs/runbooks/deliverability.md.
SES_REGION=eu-central-1
SES_FROM_ADDRESS=no-reply@send.studafy.com
EMAIL_DRY_RUN=false

# --- Push notifications (rendered into the workers task definition) ---
# Push is sent through FCM with the FIREBASE_SERVICE_ACCOUNT secret (workers app secret); the
# workers refuse to boot without it unless PUSH_DRY_RUN=true. See docs/runbooks/fcm-setup.md.
PUSH_DRY_RUN=false

# --- Error tracking (rendered into the api, workers and realtime task definitions) ---
# Sentry project studafy-server (EU). A DSN only lets a process send events, so it is config, not a
# secret; events are tagged with this tier's APP_ENV. Empty turns error tracking off.
SENTRY_DSN=https://5f2568d950a88daf0ebf87ba44b1b5e6@o4512278543335424.ingest.de.sentry.io/4512278598189136
