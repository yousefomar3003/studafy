# Deploy-time parameters for the "prod" environment. Sourced by infra/deploy/scripts/render.sh.
# See dev.env's header comment for why this file is split into "not provisioned yet" and
# "this ticket's actual policy" sections — same split applies here.

# --- Not yet provisioned by any Terraform module — fill in once the compute-tier module lands ---
ECS_CLUSTER=
ECS_EXECUTION_ROLE_ARN=
PRIVATE_APP_SUBNET_IDS=
APP_SECURITY_GROUP_ID=
API_TARGET_GROUP_ARN=
REALTIME_TARGET_GROUP_ARN=

# --- Distributed tracing (ST-260) ---
# See staging.env's own comment — same fixed DNS name, module.monitoring.monitoring_enabled is
# true here too.
OTEL_COLLECTOR_ENDPOINT=http://otel-collector.metrics.internal:4318

# --- Deploy tier and public web origin ---
# APP_ENV is the API's tier switch: anything but "development" enforces CORS_ALLOWED_ORIGINS and an
# enforcing CSP (apps/api/src/env.ts, config/security.ts). WEB_ORIGIN is the web app's public origin
# and must match web_origin in infra/terraform/environments/prod/prod.tfvars; render.sh feeds it
# to the API's CORS_ALLOWED_ORIGINS and to api/workers FRONTEND_URL (links in emails).
APP_ENV=production
WEB_ORIGIN=https://app.studafy.com

# --- Error monitoring ---
# The Sentry environment api/workers/realtime group their events under — the same tier names as
# apps/api's APP_ENV. The DSN itself is not here: it comes from each service's app-secrets
# container (SENTRY_DSN, empty = monitoring off). See apps/api/docs/error-monitoring.md.
SENTRY_ENVIRONMENT=production

# --- Rolling-update policy (this ticket's deliverable) ---
# One notch more headroom than staging (cpu/memory + desiredCount) — not a load-tested figure,
# same "starting point, not a researched sizing" caveat as dev.env/staging.env. Revisit once real
# traffic data exists.
API_DESIRED_COUNT=3
API_CPU=1024
API_MEMORY=2048
API_MIN_HEALTHY_PERCENT=100
API_MAX_PERCENT=200

REALTIME_DESIRED_COUNT=3
REALTIME_CPU=1024
REALTIME_MEMORY=2048
REALTIME_MIN_HEALTHY_PERCENT=100
REALTIME_MAX_PERCENT=200

WORKERS_DESIRED_COUNT=3
WORKERS_CPU=2048
WORKERS_MEMORY=4096
WORKERS_MIN_HEALTHY_PERCENT=100
WORKERS_MAX_PERCENT=200
