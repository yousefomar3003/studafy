# Deploy-time parameters for per-PR preview environments. Sourced by
# infra/deploy/scripts/preview-up.sh and preview-down.sh, and by .github/workflows/pr-preview.yml.
#
# Preview is NOT a fourth Terraform environment (there is no environments/preview/ overlay, no
# state bucket, no VPC of its own). It is a thin, always-on shared layer — one ECS cluster, one
# public subnet, one security group, one Route 53 zone, one non-RDS Postgres server — that every
# open PR carves an isolated slice out of. See docs/runbooks/pr-preview-environments.md.
#
# Two categories, kept separate on purpose (same split as dev.env / staging.env):
#
# 1. Values this ticket owns: the task's Fargate cpu/memory and the stale-task TTL. Real
#    defaults, unverified against real load — the same "sensible default, no researched sizing"
#    caveat infra/terraform/modules/pgbouncer/README.md already carries.
#
# 2. Values this ticket cannot fill in: the cluster, execution role, subnet, security group, DNS
#    zone, ECR registry and preview-database handles. Nothing in infra/terraform provisions a
#    preview layer yet — this file is authored ahead of it exactly as dev.env's ECS_* block was
#    authored ahead of modules/compute (see infra/deploy/README.md's "PR preview environments").
#    Fill these in once that layer exists; until then pr-preview.yml's `guard` job is the thing
#    that keeps the workflow inert (it also checks vars.AWS_DEPLOYMENTS_ENABLED).

# --- Not yet provisioned by any Terraform module — fill in once the preview layer lands ---
# Base of the preview ECR registry, e.g. 123456789012.dkr.ecr.eu-central-1.amazonaws.com.
# Expects two repositories to already exist under it: studafy-preview/api and studafy-preview/web
# (created once, out of band — see the runbook's "Prerequisites", same story as the tfstate buckets).
PREVIEW_ECR_REGISTRY=
# ECS cluster that runs preview tasks. One shared cluster; each PR is one FARGATE run-task on it,
# not a service (nothing here needs rolling updates or a desired-count > 1).
PREVIEW_ECS_CLUSTER=
# Task execution role: ECR pull from the two repos above + logs:CreateLogGroup/PutLogEvents
# (the task definition sets awslogs-create-group=true so per-PR log groups are made on first run).
PREVIEW_EXECUTION_ROLE_ARN=
# A single PUBLIC subnet. Preview tasks get a public IP on their ENI and are reached directly on
# it — there is deliberately no ALB (that is the cost of a sub-8-minute, zero-teardown-residue
# preview; staging-deploy.yml is the load-balanced, production-shaped path).
PREVIEW_SUBNET_ID=
# Security group on the task ENI. Must allow inbound tcp/8080 (the web container; the api
# container is 127.0.0.1-only inside the shared task network namespace and needs no ingress rule)
# from PREVIEW_INGRESS_CIDRS below, and all egress (ECR, the preview database, Route 53 is not
# reached from the task).
PREVIEW_SECURITY_GROUP_ID=
# Who may reach a preview. 0.0.0.0/0 makes previews world-reachable; narrow it to an office/VPN
# CIDR list (comma-separated) if previews should not be public. The workflow does not enforce
# this — it is a property of the security group named above; this line only documents the intent.
PREVIEW_INGRESS_CIDRS=0.0.0.0/0
# Route 53 hosted zone that owns PREVIEW_BASE_DOMAIN. Can be a dedicated delegated zone
# (preview.studafy.com) or the prod-owned studafy.com zone with a scoped change permission on the
# preview role — see the runbook.
PREVIEW_DNS_ZONE_ID=
# Preview hostnames are pr-<number>.$PREVIEW_BASE_DOMAIN. Because there is no ALB and no
# per-preview ACM certificate, previews are served over http on port 8080 — the posted URL
# carries the :8080 explicitly.
PREVIEW_BASE_DOMAIN=
# The ONE shared preview Postgres server. Host only (host[:port]); the credentials the ECS task
# uses come from PREVIEW_DB_SECRET_ARN, the credentials the workflow uses to create/drop/migrate
# per-PR databases come from the PREVIEW_DATABASE_ADMIN_URL GitHub Actions secret.
#
# MUST NOT be RDS and MUST NOT carry "staging"/"prod"/"preprod" in its hostname: db/seeds/guard.ts
# hard-refuses to seed against any host matching /rds\.amazonaws\.com$/, /\.rds\./ or a
# staging/production-shaped name, with no override. A self-managed Postgres (a small EC2, or a
# container) reachable at e.g. preview-db.studafy.internal is the intended shape.
PREVIEW_DB_HOST=
PREVIEW_DB_PORT=5432
# Secrets Manager ARN holding JSON keys `username` and `password` for the role the ECS task
# connects as. Same role for every preview; per-PR isolation is the database, not the login.
PREVIEW_DB_SECRET_ARN=

# --- This ticket's own parameters ---
# 512/1024 is the smallest Fargate combo that comfortably fits the Bun api process next to an
# nginx sidecar. Bump if a preview OOMs; there is no availability criterion here to protect.
PREVIEW_CPU=512
PREVIEW_MEMORY=1024
# The scheduled sweep in pr-preview-teardown.yml stops any preview task older than this, even if
# its PR is still open — a backstop for a missed `closed` event, and a hard ceiling on how long a
# forgotten preview can bill. A push to the PR rebuilds the preview and resets the clock.
PREVIEW_TASK_TTL_HOURS=72
