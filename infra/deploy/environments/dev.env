# Deploy-time parameters for the "dev" environment. Sourced by infra/deploy/scripts/render.sh.
#
# Two categories, kept separate on purpose:
#
# 1. Values this ticket actually owns: per-service replica counts, Fargate cpu/memory, and the
#    rolling-update thresholds. These are real defaults, not placeholders, but they are also
#    unverified against real load — same "dev-appropriate default, no researched sizing" caveat
#    infra/terraform/modules/pgbouncer/README.md already carries for its instance_type.
#
# 2. Values this ticket cannot fill in: cluster name, execution role, subnets, security group,
#    target groups. Nothing in infra/terraform provisions an ECS cluster, a compute-tier IAM role,
#    or an ALB target group yet (infra/terraform/README.md's status note; modules/edge/README.md's
#    "It does not create a target group"). See infra/deploy/README.md's "Known gaps /
#    prerequisites" before trying to run scripts/deploy.sh against this file.

# --- Not yet provisioned by any Terraform module — fill in once the compute-tier module lands ---
ECS_CLUSTER=
ECS_EXECUTION_ROLE_ARN=
PRIVATE_APP_SUBNET_IDS=
APP_SECURITY_GROUP_ID=
API_TARGET_GROUP_ARN=
REALTIME_TARGET_GROUP_ARN=

# --- Distributed tracing (ST-260) ---
# Empty in dev: module.monitoring's monitoring_enabled is false here (no otel-collector task
# running), so apps/*'s OTEL_EXPORTER_OTLP_ENDPOINT must stay unset rather than pointing at a Cloud
# Map name with zero registered tasks — see each app's env.ts for why an empty string, not just a
# missing key, is treated as "tracing disabled". staging.env/prod.env set the real fixed DNS name;
# it is not a terraform output (same "static, not per-environment" reasoning discovery.tf documents
# for prometheus.metrics.internal), so render.sh doesn't need to resolve it.
OTEL_COLLECTOR_ENDPOINT=

# --- Rolling-update policy (this ticket's deliverable) ---
# minimumHealthyPercent 50 in dev: one task allowed to go down during a deploy, since dev has no
# availability acceptance criterion (that's staging's job) and running 2x desiredCount during
# every rollout here would just be cost for no benefit.
API_DESIRED_COUNT=1
API_CPU=256
API_MEMORY=512
API_MIN_HEALTHY_PERCENT=50
API_MAX_PERCENT=200

REALTIME_DESIRED_COUNT=1
REALTIME_CPU=256
REALTIME_MEMORY=512
REALTIME_MIN_HEALTHY_PERCENT=50
REALTIME_MAX_PERCENT=200

WORKERS_DESIRED_COUNT=1
# Sized for two containers: workers plus the ClamAV sidecar (clamd holds ~1.5 GB of signatures
# resident). Fargate only offers memory in steps a given CPU size allows.
WORKERS_CPU=512
WORKERS_MEMORY=3072
WORKERS_MIN_HEALTHY_PERCENT=50
WORKERS_MAX_PERCENT=200

# --- Public addresses and deployment tier (rendered into the api and workers task definitions) ---
# APP_ENV is the tier apps/api/src/env.ts gates on (CORS allowlist required, mock sign-in and
# DATABASE_SSL_MODE=disable refused, Turnstile secret required outside development). WEB_ORIGIN
# is the browser origin the API allows and links back to (FRONTEND_URL / CORS_ALLOWED_ORIGINS,
# and the workers' email links); it mirrors this tier's web_origin in its terraform tfvars.
# API_ORIGIN is the public API host; the OAuth redirect URIs are derived from it and must be
# registered, character for character, on each provider's client for this tier.
APP_ENV=development
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=https://dev-api.studafy.com

# --- AI provider (rendered into the api and workers task definitions) ---
# Together AI's OpenAI-compatible API serving Qwen 3.5 for every AI feature. The credential is
# AI_LLM_API_KEY in BOTH the api and the workers app secrets (docs/runbooks/production-secrets.md).
# AI_LLM_ENABLED=true makes apps/api refuse to boot without that key, so a tier deployed without
# it fails its deploy instead of silently shipping with AI switched off. Model ids must match
# Together's exactly (https://docs.together.ai/docs/serverless/models).
AI_LLM_ENABLED=true
AI_LLM_PROVIDER=openai-compatible
AI_LLM_BASE_URL=https://api.together.xyz/v1
AI_LLM_SMALL_MODEL=Qwen/Qwen3.5-9B
AI_LLM_LARGE_MODEL=Qwen/Qwen3.5-9B

# --- ERPNext (rendered into the api task definition) ---
# Each school's Frappe site is <school-slug>.$ERPNEXT_SITE_DOMAIN, created by
# infra/deploy/scripts/erpnext-new-site.sh. Only a Host header inside the VPC (the internal ALB picks
# the site from it), never a public DNS name. ERPNEXT_API_URL itself comes from terraform output in
# render.sh, and the credential is ERPNEXT_API_KEY in the api and workers app secrets.
ERPNEXT_SITE_DOMAIN=erpnext-dev.studafy.com
