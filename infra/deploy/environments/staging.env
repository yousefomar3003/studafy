# Deploy-time parameters for the "staging" environment. Sourced by infra/deploy/scripts/render.sh.
# See dev.env's header comment for why this file is split into "not provisioned yet" and
# "this ticket's actual policy" sections — same split applies here.

# --- Not yet provisioned by any Terraform module — fill in once the compute-tier module lands ---
ECS_CLUSTER=
ECS_EXECUTION_ROLE_ARN=
PRIVATE_APP_SUBNET_IDS=
APP_SECURITY_GROUP_ID=
API_TARGET_GROUP_ARN=
REALTIME_TARGET_GROUP_ARN=

# --- Distributed tracing (ST-260) ---
# Fixed DNS name, not a terraform output — module.monitoring's Cloud Map namespace is always
# "metrics.internal" (see dev.env's own comment and discovery.tf). module.monitoring.
# monitoring_enabled is true in this environment, so the otel-collector task is actually running.
OTEL_COLLECTOR_ENDPOINT=http://otel-collector.metrics.internal:4318

# --- Rolling-update policy (this ticket's deliverable) ---
# minimumHealthyPercent 100 + desiredCount 2: the rolling deploy always keeps at least the full
# pre-deploy task count in service (ECS starts new tasks before stopping old ones, since
# maximumPercent 200 gives it room to run up to 4 tasks briefly) — this is what "0 failed synthetic
# checks during deploy" in the acceptance criteria actually requires. deploymentCircuitBreaker
# below is what makes the second half of the acceptance criteria (rollback in <5 min) automatic
# for a deploy that never reaches a healthy steady state; scripts/rollback.sh handles the case a
# bad deploy passes health checks but is wrong in some other way.
API_DESIRED_COUNT=2
API_CPU=512
API_MEMORY=1024
API_MIN_HEALTHY_PERCENT=100
API_MAX_PERCENT=200

REALTIME_DESIRED_COUNT=2
REALTIME_CPU=512
REALTIME_MEMORY=1024
REALTIME_MIN_HEALTHY_PERCENT=100
REALTIME_MAX_PERCENT=200

WORKERS_DESIRED_COUNT=2
# Sized for two containers: workers plus the ClamAV sidecar (clamd holds ~1.5 GB of signatures
# resident). Fargate only offers memory in steps a given CPU size allows.
WORKERS_CPU=1024
WORKERS_MEMORY=4096
WORKERS_MIN_HEALTHY_PERCENT=100
WORKERS_MAX_PERCENT=200

# --- Public addresses and deployment tier (rendered into the api and workers task definitions) ---
# APP_ENV is the tier apps/api/src/env.ts gates on (CORS allowlist required, mock sign-in and
# DATABASE_SSL_MODE=disable refused, Turnstile secret required outside development). WEB_ORIGIN
# is the browser origin the API allows and links back to (FRONTEND_URL / CORS_ALLOWED_ORIGINS,
# and the workers' email links); it mirrors this tier's web_origin in its terraform tfvars.
# API_ORIGIN is the public API host; the OAuth redirect URIs are derived from it and must be
# registered, character for character, on each provider's client for this tier.
APP_ENV=staging
WEB_ORIGIN=https://staging.studafy.com
API_ORIGIN=https://staging-api.studafy.com

# --- AI provider (rendered into the api and workers task definitions) ---
# Together AI's OpenAI-compatible API serving Qwen 3.5 for every AI feature. The credential is
# AI_LLM_API_KEY in BOTH the api and the workers app secrets (docs/runbooks/production-secrets.md).
# AI_LLM_ENABLED=true makes apps/api refuse to boot without that key, so a tier deployed without
# it fails its deploy instead of silently shipping with AI switched off. Model ids must match
# Together's exactly (https://docs.together.ai/docs/serverless/models).
AI_LLM_ENABLED=true
AI_LLM_PROVIDER=openai-compatible
AI_LLM_BASE_URL=https://api.together.xyz/v1
AI_LLM_SMALL_MODEL=Qwen/Qwen3.5-9B
AI_LLM_LARGE_MODEL=Qwen/Qwen3.5-9B
