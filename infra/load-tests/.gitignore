# Archived run artifacts — these are generated per-run (scripts/run.sh) and can be large across
# many runs; they belong in whatever artifact storage CI/the operator archives to, not in git.
reports/*
!reports/.gitkeep

# Fixture data generated by seed/generate-local-fixtures.ts, or supplied by an operator for a real
# environment. The example-*.json files are committed on purpose — they are the documented data
# shape, not generated output.
data/*.json
!data/example-*.json
