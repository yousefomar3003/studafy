#!/bin/bash
set -euo pipefail

# AL2023's default "postgresql" meta-package currently tracks 16.x, matching modules/postgres's
# engine — unverified against a real apply at the time this module was written (same honesty gap
# as modules/network's bastion assuming amazon-cloudwatch-agent is always in the default repo).
dnf install -y pgbouncer postgresql awscli jq amazon-cloudwatch-agent

mkdir -p /etc/pgbouncer /var/log/pgbouncer
chown pgbouncer:pgbouncer /var/log/pgbouncer

pg_secret=$(aws secretsmanager get-secret-value --region "${aws_region}" --secret-id "${postgres_secret_arn}" --query SecretString --output text)
pgb_secret=$(aws secretsmanager get-secret-value --region "${aws_region}" --secret-id "${pgbouncer_secret_arn}" --query SecretString --output text)

PG_HOST=$(echo "$pg_secret" | jq -r .host)
PG_PORT=$(echo "$pg_secret" | jq -r .port)
PG_DB=$(echo "$pg_secret" | jq -r .dbname)
PG_USER=$(echo "$pg_secret" | jq -r .username)
PG_PASS=$(echo "$pg_secret" | jq -r .password)

STATS_PASS=$(echo "$pgb_secret" | jq -r .stats_password)
SERVICE_USERS=$(echo "$pgb_secret" | jq -r '.service_credentials | to_entries[] | "\"\(.key)\" \"\(.value)\""')

echo "$pgb_secret" | jq -r .server_cert_pem > /etc/pgbouncer/server.crt
echo "$pgb_secret" | jq -r .server_key_pem  > /etc/pgbouncer/server.key
echo "$pgb_secret" | jq -r .ca_cert_pem     > /etc/pgbouncer/ca.crt
chmod 600 /etc/pgbouncer/server.key
chown pgbouncer:pgbouncer /etc/pgbouncer/server.crt /etc/pgbouncer/server.key /etc/pgbouncer/ca.crt

# Plaintext, not an MD5/SCRAM hash: no per-service Postgres role exists yet (only the master
# credential — docs/runbooks/postgres-conventions.md's "Known gaps"), and PgBouncer only has the
# plaintext password to work with, not the hash Postgres itself stores. PgBouncer's userlist.txt
# format explicitly supports a plaintext entry for exactly this reason: it completes whichever auth
# method (here, scram-sha-256) the client negotiates, computed fresh per connection.
cat > /etc/pgbouncer/userlist.txt <<USERLIST
"$PG_USER" "$PG_PASS"
$${SERVICE_USERS}
"${stats_username}" "$STATS_PASS"
USERLIST
chmod 600 /etc/pgbouncer/userlist.txt
chown pgbouncer:pgbouncer /etc/pgbouncer/userlist.txt

cat > /etc/pgbouncer/pgbouncer.ini <<INI
[databases]
%{ for name, pool in service_pools ~}
${name} = host=$PG_HOST port=$PG_PORT dbname=$PG_DB user=$PG_USER pool_size=${pool.pool_size} reserve_pool_size=${pool.reserve_pool_size}
%{ endfor ~}
%{ for name, pool in read_pools ~}
${name} = host=${read_replica_host} port=$PG_PORT dbname=$PG_DB user=$PG_USER pool_size=${pool.pool_size} reserve_pool_size=${pool.reserve_pool_size}
%{ endfor ~}

[pgbouncer]
listen_addr = *
listen_port = ${listen_port}
unix_socket_dir =

auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt

; Transaction pooling: a server connection is only ever assigned to a client for the
; duration of one transaction, then returned to the pool. This is what makes pool_size far
; smaller than max_client_conn viable — see docs/runbooks/pgbouncer-conventions.md for what
; that means for session-scoped SQL (use SET LOCAL, not SET).
pool_mode = transaction

max_client_conn = ${max_client_conn}
default_pool_size = ${default_pool_size}

admin_users = $PG_USER
stats_users = ${stats_username}

; RDS already rejects a non-SSL connection outright (rds.force_ssl=1, modules/postgres) — this is
; belt-and-suspenders so PgBouncer never even attempts a plaintext backend connection.
server_tls_sslmode = require

; Self-signed CA generated by this module (tls_self_signed_cert), not ACM: ACM certificates'
; private keys are not exportable for a non-ACM-integrated TLS listener like this one, and standing
; up ACM Private CA is a cost/complexity jump this module's KISS scope doesn't justify. Clients
; verify against ca.crt (also in the secret below) with sslmode=verify-ca — not verify-full, since
; this single instance has no stable DNS name yet (no Route 53 private zone — see README's known
; gaps) for a certificate SAN to match.
client_tls_sslmode = require
client_tls_cert_file = /etc/pgbouncer/server.crt
client_tls_key_file = /etc/pgbouncer/server.key
client_tls_ca_file = /etc/pgbouncer/ca.crt

ignore_startup_parameters = extra_float_digits,options

logfile = /var/log/pgbouncer/pgbouncer.log
pidfile = /run/pgbouncer/pgbouncer.pid
INI
chown pgbouncer:pgbouncer /etc/pgbouncer/pgbouncer.ini

systemctl enable --now pgbouncer

# RDS rotation changes the backend password without changing the stable client credentials above.
# Refresh the master entry and RELOAD PgBouncer every minute so rotation never requires an EC2
# replacement or an application credential change.
cat > /usr/local/bin/pgbouncer-refresh-credentials.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail

pg_secret=$(aws secretsmanager get-secret-value --region "__AWS_REGION__" --secret-id "__POSTGRES_SECRET_ARN__" --query SecretString --output text)
pgb_secret=$(aws secretsmanager get-secret-value --region "__PGB_REGION__" --secret-id "__PGBOUNCER_SECRET_ARN__" --query SecretString --output text)

PG_USER=$(echo "$pg_secret" | jq -r .username)
PG_PASS=$(echo "$pg_secret" | jq -r .password)
STATS_USER=$(echo "$pgb_secret" | jq -r .stats_username)
STATS_PASS=$(echo "$pgb_secret" | jq -r .stats_password)

tmp=$(mktemp)
{
  printf '"%s" "%s"\n' "$PG_USER" "$PG_PASS"
  echo "$pgb_secret" | jq -r '.service_credentials | to_entries[] | "\"\(.key)\" \"\(.value)\""'
  printf '"%s" "%s"\n' "$STATS_USER" "$STATS_PASS"
} > "$tmp"
install -o pgbouncer -g pgbouncer -m 600 "$tmp" /etc/pgbouncer/userlist.txt
rm -f "$tmp"
systemctl reload pgbouncer
SCRIPT

sed -i \
  -e "s#__AWS_REGION__#${aws_region}#" \
  -e "s#__PGB_REGION__#${aws_region}#" \
  -e "s#__POSTGRES_SECRET_ARN__#${postgres_secret_arn}#" \
  -e "s#__PGBOUNCER_SECRET_ARN__#${pgbouncer_secret_arn}#" \
  /usr/local/bin/pgbouncer-refresh-credentials.sh
chmod 700 /usr/local/bin/pgbouncer-refresh-credentials.sh

cat > /etc/systemd/system/pgbouncer-refresh-credentials.service <<'UNIT'
[Unit]
Description=Refresh PgBouncer backend credentials from Secrets Manager
After=network-online.target pgbouncer.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pgbouncer-refresh-credentials.sh
UNIT

cat > /etc/systemd/system/pgbouncer-refresh-credentials.timer <<'UNIT'
[Unit]
Description=Refresh PgBouncer credentials after RDS secret rotation

[Timer]
OnBootSec=60
OnUnitActiveSec=60
RandomizedDelaySec=10

[Install]
WantedBy=timers.target
UNIT

cat <<CONFIG > /opt/aws/amazon-cloudwatch-agent/etc/config.json
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/pgbouncer/pgbouncer.log",
            "log_group_name": "${log_group_name}",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
CONFIG

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/config.json

# Pool-saturation metrics: PgBouncer has no CloudWatch integration of its own, and this repo has no
# Prometheus/Grafana stack to scrape a /metrics endpoint (every other module's observability is
# CloudWatch-native — VPC flow logs, the bastion's shipped SSH log). SHOW POOLS's own columns are
# parsed directly, not a general-purpose exporter: cl_waiting > 0 sustained is the actual
# saturation signal (clients queued because every server connection in the pool is busy).
#
# The stats password is baked in at boot (below, via sed) rather than re-fetched from Secrets
# Manager on every timer tick — it already lives in plaintext in /etc/pgbouncer/userlist.txt on
# this same instance, so this adds no new exposure, and avoids hitting the Secrets Manager API
# once a minute.
cat > /usr/local/bin/pgbouncer-metrics.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail

export PGPASSWORD="__STATS_PASS__"

rows=$(psql "host=127.0.0.1 port=__LISTEN_PORT__ dbname=pgbouncer user=__STATS_USER__ sslmode=verify-ca sslrootcert=/etc/pgbouncer/ca.crt" \
  -X -A -t -F',' -c "SHOW POOLS;")

# SHOW POOLS columns: database,user,cl_active,cl_waiting,cl_active_cancel_req,cl_waiting_cancel_req,
# sv_active,sv_active_cancel,sv_being_canceled,sv_idle,sv_used,sv_tested,sv_login,maxwait,maxwait_us,pool_mode
while IFS=',' read -r db usr cl_active cl_waiting _ _ sv_active _ _ sv_idle sv_used _ _ maxwait _ _; do
  [ "$db" = "pgbouncer" ] && continue
  [ -z "$db" ] && continue

  aws cloudwatch put-metric-data --region "__AWS_REGION__" --namespace "__NAMESPACE__" --metric-data \
    "MetricName=ClientsWaiting,Value=$cl_waiting,Unit=Count,Dimensions=[{Name=Pool,Value=$db}]" \
    "MetricName=ClientsActive,Value=$cl_active,Unit=Count,Dimensions=[{Name=Pool,Value=$db}]" \
    "MetricName=ServersActive,Value=$sv_active,Unit=Count,Dimensions=[{Name=Pool,Value=$db}]" \
    "MetricName=ServersIdle,Value=$sv_idle,Unit=Count,Dimensions=[{Name=Pool,Value=$db}]" \
    "MetricName=ServersUsed,Value=$sv_used,Unit=Count,Dimensions=[{Name=Pool,Value=$db}]" \
    "MetricName=MaxWaitSeconds,Value=$maxwait,Unit=Seconds,Dimensions=[{Name=Pool,Value=$db}]"
done <<< "$rows"
SCRIPT

sed -i \
  -e "s/__STATS_PASS__/$STATS_PASS/" \
  -e "s/__LISTEN_PORT__/${listen_port}/" \
  -e "s/__STATS_USER__/${stats_username}/" \
  -e "s/__AWS_REGION__/${aws_region}/" \
  -e "s/__NAMESPACE__/${cloudwatch_namespace}/" \
  /usr/local/bin/pgbouncer-metrics.sh
chmod 700 /usr/local/bin/pgbouncer-metrics.sh

cat > /etc/systemd/system/pgbouncer-metrics.service <<'UNIT'
[Unit]
Description=Push PgBouncer pool-saturation metrics to CloudWatch

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pgbouncer-metrics.sh
UNIT

cat > /etc/systemd/system/pgbouncer-metrics.timer <<TIMER
[Unit]
Description=Run pgbouncer-metrics.service every ${metrics_interval_seconds}s

[Timer]
OnBootSec=30
OnUnitActiveSec=${metrics_interval_seconds}

[Install]
WantedBy=timers.target
TIMER

systemctl daemon-reload
systemctl enable --now pgbouncer-metrics.timer
systemctl enable --now pgbouncer-refresh-credentials.timer
