{
  "name": "studafy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "typecheck": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "bun packages/db/src/cli.ts migrate",
    "db:migrate:status": "bun packages/db/src/cli.ts status",
    "db:migrate:validate": "bun packages/db/src/cli.ts validate",
    "db:migrate:pending": "bun packages/db/src/cli.ts pending",
    "db:seed": "bun packages/db/src/cli.ts seed",
    "db:attendance:partitions": "bun packages/db/src/cli.ts attendance-partitions",
    "db:audit:partitions": "bun packages/db/src/cli.ts audit-partitions",
    "db:test:rls-coverage": "bun packages/db/src/cli.ts rls-coverage",
    "test:security": "bun run --cwd apps/api test:security",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@studafy/config": "workspace:*",
    "@studafy/tsconfig": "workspace:*",
    "eslint": "10.6.0",
    "lefthook": "2.1.9",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "turbo": "2.10.3",
    "typescript": "^5.9.3"
  }
}
