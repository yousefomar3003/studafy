{
  "name": "studafy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "typecheck": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@studafy/config": "workspace:*",
    "eslint": "10.6.0",
    "lefthook": "2.1.9",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "turbo": "2.10.3",
    "typescript": "^5.9.3"
  }
}
