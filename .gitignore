node_modules/
dist/
storybook-static/
.turbo/
*.tsbuildinfo
playwright-report/
test-results/
coverage/

# Terraform — see infra/terraform/README.md
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
# Local overrides used for offline planning; never committed.
override.tf
override.tf.json
*_override.tf
*_override.tf.jzson
.terraformrc
terraform.rc
# Variable files may carry secrets, so they are ignored by default. The committed
# environment overlays are non-secret by construction and re-included explicitly.
*.tfvars
*.tfvars.json
!infra/terraform/environments/**/*.tfvars
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider checksums.
# The realtime probe Lambda's deployment zip is built by the archive provider at plan/apply time.
infra/terraform/modules/monitoring/lambda/realtime-probe/index.zip

# Environment
.env

# Database backups
backups/

# Generated — regenerated on demand or in CI; avoid merge conflicts
apps/api/openapi.json
packages/api-client/src/generated-types.ts
apps/mobile/lib/src/core/api/generated/
*.lnk
