{
  "name": "@studafy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "test:integration": "bun test ./tests/harness --timeout 60000",
    "test:auth": "bun test ./tests/auth --timeout 90000",
    "test:security": "bun test ./tests/security --timeout 90000",
    "test:reports": "bun test ./tests/reports --timeout 90000",
    "test:cross-tenant": "bun test ./tests/security/cross-tenant.test.ts ./tests/security/probe-support.test.ts --timeout 90000",
    "test:ai-eval": "bun test ./tests/ai-eval --timeout 30000",
    "generate": "bun run openapi:generate",
    "openapi:generate": "bun run scripts/generate-openapi.ts && prettier --write openapi.json"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/s3-request-presigner": "3.1097.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@hono/zod-openapi": "1.5.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@scalar/hono-api-reference": "0.11.11",
    "@studafy/announcements": "workspace:*",
    "@studafy/attendance-reporting": "workspace:*",
    "@studafy/audit-reporting": "workspace:*",
    "@studafy/billing": "workspace:*",
    "@studafy/constants": "workspace:*",
    "@studafy/finance-reporting": "workspace:*",
    "@studafy/grades-reporting": "workspace:*",
    "@studafy/grading-engine": "workspace:*",
    "@studafy/license-pricing": "workspace:*",
    "@studafy/notification-templates": "workspace:*",
    "@studafy/observability": "workspace:*",
    "@studafy/sanitize": "workspace:*",
    "@studafy/shared-schemas": "workspace:*",
    "@studafy/student-import": "workspace:*",
    "@studafy/tap-payments": "workspace:*",
    "bullmq": "5.79.3",
    "google-auth-library": "11.3.0",
    "hono": "4.12.34",
    "ioredis": "5.10.1",
    "jose": "6.2.3",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "stripe": "22.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.9.0",
    "@studafy/config": "workspace:*",
    "@studafy/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "eslint": "10.6.0",
    "typescript": "^5.9.3"
  }
}
