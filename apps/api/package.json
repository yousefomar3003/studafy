{
  "name": "@studafy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "test:integration": "bun test ./tests/harness --timeout 60000",
    "test:auth": "bun test ./tests/auth --timeout 90000",
    "test:security": "bun test ./tests/security --timeout 90000",
    "test:cross-tenant": "bun test ./tests/security/cross-tenant.test.ts ./tests/security/probe-support.test.ts --timeout 90000",
    "generate": "bun run openapi:generate",
    "openapi:generate": "bun run scripts/generate-openapi.ts && prettier --write openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/s3-request-presigner": "3.1097.0",
    "@hono/zod-openapi": "1.5.1",
    "@scalar/hono-api-reference": "0.11.11",
    "@studafy/attendance-reporting": "workspace:*",
    "@studafy/billing": "workspace:*",
    "@studafy/constants": "workspace:*",
    "@studafy/finance-reporting": "workspace:*",
    "@studafy/notification-templates": "workspace:*",
    "@studafy/shared-schemas": "workspace:*",
    "bullmq": "5.79.3",
    "hono": "4.12.28",
    "ioredis": "5.10.1",
    "jose": "6.2.3",
    "postgres": "3.4.9",
    "stripe": "22.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.9.0",
    "@studafy/config": "workspace:*",
    "@studafy/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "^5.9.3"
  }
}
