{
  "name": "@studafy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "test:security": "bun test ./tests/security --timeout 90000"
  },
  "dependencies": {
    "hono": "4.12.28",
    "postgres": "3.4.9",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@studafy/config": "workspace:*",
    "@studafy/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "^5.9.3"
  }
}
