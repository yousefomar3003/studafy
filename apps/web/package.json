    "@studafy/shared-schemas": "workspace:*",
    "@studafy/ui": "workspace:*",
    "@tanstack/react-query": "5.101.2",
    "i18next": "23.16.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "react-router-dom": "6.30.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
