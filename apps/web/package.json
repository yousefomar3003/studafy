    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "axe-core": "4.10.3",
