{
  "name": "@studafy/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "build:ocr": "bun build node_modules/tesseract.js/src/worker-script/node/index.js --outdir dist/ocr --target bun && bun run scripts/copy-ocr-assets.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "smoke-test": "bun run scripts/smoke-test.ts",
    "generate:fixtures": "bun run src/queues/ai-ingestion/__fixtures__/generate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/client-sesv2": "3.1097.0",
    "@aws-sdk/s3-request-presigner": "3.1097.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@napi-rs/canvas": "1.0.3",
    "@pdf-lib/fontkit": "1.1.1",
    "@studafy/announcements": "workspace:*",
    "@studafy/attendance-reporting": "workspace:*",
    "@studafy/audit-reporting": "workspace:*",
    "@studafy/billing": "workspace:*",
    "@studafy/constants": "workspace:*",
    "@studafy/finance-reporting": "workspace:*",
    "@studafy/grades-reporting": "workspace:*",
    "@studafy/notification-templates": "workspace:*",
    "@studafy/progress-reporting": "workspace:*",
    "@xmldom/xmldom": "0.8.13",
    "bidi-js": "1.0.3",
    "bullmq": "5.79.3",
    "exceljs": "4.4.0",
    "firebase-admin": "14.2.0",
    "ioredis": "5.10.1",
    "jszip": "3.10.1",
    "mammoth": "1.12.0",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "stripe": "22.4.0",
    "tesseract.js": "7.0.0",
    "unpdf": "1.8.0",
    "uuid": "11.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@studafy/config": "workspace:*",
    "@studafy/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "^5.9.3"
  }
}
