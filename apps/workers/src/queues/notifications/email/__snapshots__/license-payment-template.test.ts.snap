exports[`renderLicensePaymentEmail en instalment_overdue 1`] = `
{
  "html": "<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f5f7;padding:24px 0"><tr><td align="center"><table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:8px;overflow:hidden"><tr><td style="padding:24px 32px;border-bottom:1px solid #e6e8eb"><p style="margin:0;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;color:#1a2332">Amman Academy</p></td></tr><tr><td style="padding:32px;font-family:Arial,sans-serif;font-size:14px;line-height:1.6;color:#333c47"><div dir="ltr" style="text-align:left"><p>Payment 2 of 12 on invoice LIC-2026-000042 was due on 1 November 2026, and 250.00 USD is still unpaid.</p><p><strong>If it is still unpaid on 1 December 2026, Studafy AI stops for every seat on the licence until it is paid.</strong></p><p>Licence: Amman Academy, 1 October 2026 to 1 October 2027.</p><p style="margin-bottom:4px"><strong>How to pay</strong></p><p style="margin-top:0">Bank transfer to Studafy FZ-LLC, Arab Bank<br>IBAN: JO94CBJO0010000000000131000302<br>SWIFT/BIC: ARABJOAX<br>Currency: USD</p><p>Write the payment reference STF-AB12-CD34 on the transfer, then upload the receipt on the invoice page.</p><p style="margin:24px 0"><a href="https://checkout.revolut.com/pay/abc" style="display:inline-block;padding:10px 20px;background-color:#2563eb;color:#ffffff;text-decoration:none;border-radius:6px;font-family:Arial,sans-serif;font-size:14px;font-weight:bold">Pay online</a></p><p style="margin:24px 0"><a href="https://app.studafy.test/portal/license/invoices/i-1" style="display:inline-block;padding:10px 20px;background-color:#2563eb;color:#ffffff;text-decoration:none;border-radius:6px;font-family:Arial,sans-serif;font-size:14px;font-weight:bold">View the invoice</a></p><p style="color:#6b7480;font-size:12px">You receive this email because you manage your school&#39;s Studafy licence.</p></div></td></tr></table></td></tr></table>",
  "subject": "Payment overdue: invoice LIC-2026-000042 for Amman Academy's Studafy licence",
  "text": 
"Payment 2 of 12 on invoice LIC-2026-000042 was due on 1 November 2026, and 250.00 USD is still unpaid.
If it is still unpaid on 1 December 2026, Studafy AI stops for every seat on the licence until it is paid.
Licence: Amman Academy, 1 October 2026 to 1 October 2027.

How to pay:
Bank transfer to Studafy FZ-LLC, Arab Bank
IBAN: JO94CBJO0010000000000131000302
SWIFT/BIC: ARABJOAX
Currency: USD
Write the payment reference STF-AB12-CD34 on the transfer, then upload the receipt on the invoice page.
Or pay online: https://checkout.revolut.com/pay/abc

View the invoice: https://app.studafy.test/portal/license/invoices/i-1

You receive this email because you manage your school's Studafy licence."
,
}
`;

