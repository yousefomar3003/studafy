<?xml version="1.0" encoding="utf-8"?>
<!-- The launch splash: the white Studafy wordmark on navy, matching the Flutter splash that
     follows it (lib/src/features/launch/presentation/brand_splash.dart). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_wordmark" />
    </item>
</layer-list>
