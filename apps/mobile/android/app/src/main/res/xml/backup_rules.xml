<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below (android:fullBackupContent). Session tokens live in the
     FlutterSecureStorage prefs file, encrypted with a Keystore key that never leaves this device:
     backing it up would ship tokens off-device and restore a file nothing can decrypt.
     QA-080: files/ and databases/ are excluded too. The offline cache and downloaded materials
     (grades, announcements, school files) now live in the cache directory, which backups never
     include; these rules keep any copy an older build left in files/ out of a backup, so a restore
     can't bring one account's data back under another. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
