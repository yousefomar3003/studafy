{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "dependsOn": ["^build"],
      "outputs": ["src/generated-types.ts"],
      "env": ["LOCALAPPDATA"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", "build/**"],
      "env": ["LOCALAPPDATA"]
    },
    "check-types": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": [],
      "env": ["LOCALAPPDATA"]
    }
  }
}
